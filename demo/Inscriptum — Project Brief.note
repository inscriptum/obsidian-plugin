  "content": [
    {
      "type": "noteTitle",
      "content": [
        {
          "type": "text",
          "text": "Inscriptum — Project Brief"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "marks": [
            {
              "type": "bold"
            }
          ],
          "text": "A small local-first workspace for personal knowledge."
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Overview"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Inscriptum is a lightweight workspace for "
        },
        {
          "type": "text",
          "marks": [
            {
              "type": "highlight",
              "attrs": {
                "color": null
              }
            }
          ],
          "text": "collecting ideas, writing documents, and organizing research in one place"
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "The goal is simple: keep your information "
        },
        {
          "type": "text",
          "marks": [
            {
              "type": "bold"
            }
          ],
          "text": "local, structured, and $ to work with"
        },
        {
          "type": "text",
          "text": " without requiring a separate cloud service."
        }
      ]
    },
    {
      "type": "blockquote",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "bold"
                }
              ],
              "text": "Principle:"
            },
            {
              "type": "text",
              "text": " your documents should remain useful even without the application that created them."
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Goals"
        }
      ]
    },
    {
      "type": "taskList",
