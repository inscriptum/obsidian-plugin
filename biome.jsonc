{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	// Formatter-only setup: linting stays in ESLint (eslint-plugin-obsidianmd).
	"files": {
		"includes": [
			"**",
			"!**/node_modules/**",
			"!**/dist/**",
			"!**/.obsidian/**",
			"!**/local/**",
			"!**/.kley/**",
			"!main.js",
			"!styles.css",
			"!package-lock.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 80
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"css": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"linter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	}
}
